<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false">
  <targets>
    <target xsi:type="File"
            name="file"
            fileName="${specialfolder:folder=LocalApplicationData}/AppTemplate/logs/${shortdate}.log"
            layout="${longdate} [${level:uppercase=true:padding=-5}] ${logger:shortName=true} — ${message} ${exception:format=tostring}"
            archiveEvery="Day"
            maxArchiveFiles="30"
            keepFileOpen="true"
            concurrentWrites="false"
            encoding="utf-8" />

    <!-- Console target — useful during development; set minlevel="Off" to silence in production -->
    <target xsi:type="Console"
            name="console"
            layout="${time} [${level:uppercase=true:padding=-5}] ${logger:shortName=true} — ${message} ${exception:format=tostring}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Debug" writeTo="file" />
    <logger name="*" minlevel="Debug" writeTo="console" />
  </rules>
</nlog>
