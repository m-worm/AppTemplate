<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AppTemplate.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
             x:Class="AppTemplate.Views.MainView"
             x:DataType="vm:MainViewModel">

  <ui:FANavigationView Name="NavView"
                       PaneDisplayMode="Auto"
                       IsSettingsVisible="False"
                       IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}">

    <ui:FANavigationView.MenuItems>
      <ui:FANavigationViewItem Name="NavHome"       Content="Home"        Tag="Home" />
      <ui:FANavigationViewItem Name="NavHelloWorld" Content="Hello World" Tag="HelloWorld" />
    </ui:FANavigationView.MenuItems>

    <ui:FANavigationView.FooterMenuItems>
      <ui:FANavigationViewItem Name="NavSettings" Content="Settings" Tag="Settings" />
    </ui:FANavigationView.FooterMenuItems>

    <ContentControl Content="{Binding CurrentPage}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />

  </ui:FANavigationView>
</UserControl>
